# Local development only. Never commit .env or real credentials.
# Compose uses an isolated project/volume and loopback-only ports.
WEATHER_DB_PORT=15432
WEATHER_API_PORT=18001
DATABASE_URL=postgresql://tfm:tfm@localhost:15432/tfm
RATE_LIMIT_WINDOW_MS=60000

# Inference requires a GPU. CUDA on AWS; mps for a native macOS worker.
DEVICE=cuda
# Provision the pinned snapshot before starting the worker; no runtime downloads.
HF_HUB_CACHE=/models/hub
WEATHER_REPLAY_ROOT=results/weather/india_station_seasonal_v1/holdout/cases
# Optional independent operator secret. /metrics is disabled when unset.
WEATHER_METRICS_TOKEN=
# Local startup applies migrations. AWS uses 0 and a separate operator job.
DATABASE_AUTO_MIGRATE=1
# AWS receives credentials through a memory-backed init-container mount.
# Do not set DATABASE_URL together with DATABASE_SECRET_FILE.
# DATABASE_SECRET_FILE=/run/weather/database.json
# DATABASE_HOST=your-private-rds-endpoint
# DATABASE_NAME=weather
# DATABASE_SSL_ROOT_CERT=/run/weather/root.pem
