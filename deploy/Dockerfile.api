FROM cgr.dev/chainguard/python@sha256:51274932070a8fb2fd984e708986da133e52996de20a36a7a30e77986aade140 AS build
USER root
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --only-group weather-api --no-install-project --python /usr/bin/python

FROM cgr.dev/chainguard/python@sha256:5a673ff2d9917725286c8ca258977b476638f74f1556290cb316ec037ee6e199
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY timesfm_serve ./timesfm_serve
# The price half of the API. It reads stored forecasts only, so it brings no
# numpy or pandas with it.
COPY iex ./iex
COPY migrations ./migrations
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" PYTHONPATH=/app WEATHER_REPLAY_ROOT=/replays \
    PGCONNECT_TIMEOUT=5 PGOPTIONS="-c statement_timeout=10000 -c lock_timeout=5000"
USER 10001:10001
ENTRYPOINT []
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=2)"]
CMD ["uvicorn", "timesfm_serve.api:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
