FROM cgr.dev/chainguard/python@sha256:aa89119db7f7fb4a6628ac82e2c38404cc64cd56ccd858d2c78646776b3fffef AS build
USER root
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --only-group weather-api --no-install-project --python /usr/bin/python

FROM cgr.dev/chainguard/python@sha256:115532a106aff6e820cd637809edd0c9239f2269d46fb9937cac703cc4d101e5
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY timesfm_serve ./timesfm_serve
COPY migrations ./migrations
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" PYTHONPATH=/app WEATHER_REPLAY_ROOT=/replays \
    PGCONNECT_TIMEOUT=5 PGOPTIONS="-c statement_timeout=10000 -c lock_timeout=5000"
USER 10001:10001
ENTRYPOINT []
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=2)"]
CMD ["uvicorn", "timesfm_serve.weather_api:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
