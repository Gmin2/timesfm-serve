FROM cgr.dev/chainguard/python@sha256:51274932070a8fb2fd984e708986da133e52996de20a36a7a30e77986aade140 AS build
USER root
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --extra gpu --group weather-bootstrap --python /usr/bin/python

FROM cgr.dev/chainguard/python@sha256:5a673ff2d9917725286c8ca258977b476638f74f1556290cb316ec037ee6e199
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY timesfm_serve ./timesfm_serve
COPY scripts ./scripts
COPY migrations ./migrations
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" PYTHONPATH=/app DEVICE=cuda \
    HF_HUB_CACHE=/models/hub HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 WEATHER_REPLAY_ROOT=/replays
USER 10001:10001
ENTRYPOINT []
HEALTHCHECK --interval=15s --timeout=3s --start-period=120s --retries=3 \
    CMD ["python", "-m", "timesfm_serve.weather_worker", "--check-ready"]
CMD ["python", "-m", "timesfm_serve.weather_worker"]
