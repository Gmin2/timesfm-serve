FROM cgr.dev/chainguard/python@sha256:aa89119db7f7fb4a6628ac82e2c38404cc64cd56ccd858d2c78646776b3fffef AS build
USER root
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --extra gpu --group weather-bootstrap --python /usr/bin/python

FROM cgr.dev/chainguard/python@sha256:115532a106aff6e820cd637809edd0c9239f2269d46fb9937cac703cc4d101e5
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY timesfm_serve ./timesfm_serve
COPY scripts ./scripts
COPY migrations ./migrations
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" PYTHONPATH=/app DEVICE=cuda \
    HF_HUB_CACHE=/models/hub HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 WEATHER_REPLAY_ROOT=/replays
USER 10001:10001
ENTRYPOINT []
HEALTHCHECK --interval=15s --timeout=3s --start-period=120s --retries=3 \
    CMD ["python", "-m", "timesfm_serve.weather_worker", "--check-ready"]
CMD ["python", "-m", "timesfm_serve.weather_worker"]
