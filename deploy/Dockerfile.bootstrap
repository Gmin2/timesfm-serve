FROM cgr.dev/chainguard/python@sha256:51274932070a8fb2fd984e708986da133e52996de20a36a7a30e77986aade140 AS build
USER root
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --only-group weather-bootstrap --no-install-project --python /usr/bin/python

FROM cgr.dev/chainguard/python@sha256:5a673ff2d9917725286c8ca258977b476638f74f1556290cb316ec037ee6e199
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY timesfm_serve ./timesfm_serve
COPY scripts ./scripts
COPY migrations ./migrations
COPY deploy/rds-global-bundle.pem /certs/rds-global-bundle.pem
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" PYTHONPATH=/app AWS_EC2_METADATA_DISABLED=true \
    PGCONNECT_TIMEOUT=5 PGOPTIONS="-c statement_timeout=10000 -c lock_timeout=5000"
USER 10001:10001
ENTRYPOINT []
CMD ["python", "-m", "scripts.weather_cloud_init"]
